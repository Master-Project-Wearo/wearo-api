generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_conversations {
  ai_conversation_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String?
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  user_id            String        @db.Uuid
  users              users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  ai_messages        ai_messages[]

  @@index([user_id, created_at], map: "idx_ai_conversations_user_created")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_messages {
  ai_message_id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content            String
  role               String
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  ai_conversation_id String           @db.Uuid
  outfit_id          String?          @db.Uuid
  ai_conversations   ai_conversations @relation(fields: [ai_conversation_id], references: [ai_conversation_id], onDelete: Cascade, onUpdate: NoAction)
  outfits            outfits?         @relation(fields: [outfit_id], references: [outfit_id], onUpdate: NoAction)

  @@index([ai_conversation_id, created_at], map: "idx_ai_messages_conversation_created")
  @@index([outfit_id], map: "idx_ai_messages_outfit")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model items {
  item_id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image_url      String?
  web_url        String?
  name           String
  ai_description String?
  ai_attributes  Json?
  ai_embedding   Unsupported("vector")?
  price          Decimal?               @db.Decimal
  brand          String?
  colors         String[]
  is_favorite    Boolean?
  added_at       DateTime               @default(now()) @db.Timestamptz(6)
  user_id        String                 @db.Uuid
  type_id        String?                @db.Uuid
  types          types?                 @relation(fields: [type_id], references: [type_id], onUpdate: NoAction)
  users          users                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  outfit_items   outfit_items[]

  @@index([user_id, added_at], map: "idx_items_user_added")
  @@index([type_id], map: "idx_items_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model outfit_items {
  outfit_id String  @db.Uuid
  item_id   String  @db.Uuid
  items     items   @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
  outfits   outfits @relation(fields: [outfit_id], references: [outfit_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outfit_id, item_id])
  @@index([item_id], map: "idx_outfit_items_item")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model outfits {
  outfit_id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  theme            String?
  calculated_price Decimal?       @db.Decimal
  is_favorite      Boolean?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  user_id          String         @db.Uuid
  ai_messages      ai_messages[]
  outfit_items     outfit_items[]
  users            users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  schedules        schedules[]

  @@index([user_id, created_at], map: "idx_outfits_user_created")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schedules {
  schedule_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planned_for DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  user_id     String   @db.Uuid
  outfit_id   String   @db.Uuid
  outfits     outfits  @relation(fields: [outfit_id], references: [outfit_id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, planned_for], map: "idx_schedules_user_planned")
  @@index([outfit_id], map: "idx_schedules_outfit")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model types {
  type_id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  items       items[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// The database also links users.user_id to auth.users.id. That Supabase-owned schema is intentionally excluded from this application client.
model users {
  user_id              String             @id @db.Uuid
  profile_picture_url  String?
  background_image_url String?
  firstname            String?
  lastname             String?
  email                String             @unique
  description          String?
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  ai_conversations     ai_conversations[]
  items                items[]
  outfits              outfits[]
  schedules            schedules[]
}
